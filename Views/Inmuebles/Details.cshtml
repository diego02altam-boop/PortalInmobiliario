@model PortalInmobiliario.Models.Inmueble
@using PortalInmobiliario.Models

@{
    ViewData["Title"] = Model.Titulo;
}

<h2>@Model.Titulo</h2>

<div class="row">
    <div class="col-md-7">
        <img class="img-fluid rounded mb-3" 
             src="@(Model.Imagen ?? "https://via.placeholder.com/960x540?text=Inmueble")" />
    </div>
    <div class="col-md-5">
        <h4>@Model.Precio.ToString("C0")</h4>
        <p><strong>@Model.Ciudad</strong> — @Model.Direccion</p>
        <p>@Model.MetrosCuadrados m² • @Model.Dormitorios Hab • @Model.Banos Baños</p>

        <a class="btn btn-secondary mb-3" asp-action="Index">Volver al catálogo</a>

        <hr />
        <!-- Formulario Agendar Visita -->
        <h5>Agendar visita</h5>
        <form asp-controller="Visitas" asp-action="Crear" method="post">
            <input type="hidden" name="InmuebleId" value="@Model.Id" />

            <div class="mb-2">
                <label class="form-label">Inicio</label>
                <input type="datetime-local" name="FechaInicio" class="form-control" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Fin</label>
                <input type="datetime-local" name="FechaFin" class="form-control" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Notas</label>
                <textarea name="Notas" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Agendar</button>
        </form>

        <hr />
        <!-- Botón Reserva -->
        <form asp-controller="Reservas" asp-action="Crear" method="post">
            <input type="hidden" name="InmuebleId" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Reservar ahora (48h)</button>
        </form>
    </div>
</div>
